---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WireHero from '../components/WireHero.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { services } from '../data/services';
import { industries } from '../data/industries';
import { machineGroups, machineCount } from '../data/machines';
import { routes, ui, type Lang } from '../i18n/ui';
import bauteil from '../assets/img/bauteil-blau.jpg';
import pharma from '../assets/img/pharma-bauteil.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];

const c = {
  de: {
    title: 'Lohnerodieren & Drahterodieren für Deutschland & Europa | GRO',
    description: 'Drahterodieren bis 500 mm Höhe, 5-Achs-CNC-Fräsen, Mikrobohren ab Ø 0,1 mm, Schleifen & Oberflächen aus einer Hand – für ganz Deutschland & Europa.',
    introKicker: 'Über uns',
    introTitle: 'Präzision, Innovation und Service aus einer Hand.',
    intro: [
      'Seit 2011 steht die GRO-Erodiertechnik GmbH für höchste Präzision und Zuverlässigkeit in der Metallbearbeitung. An unserem Standort in Bad Schwartau – direkt vor den Toren Lübecks – fertigen wir vom Einzelteil bis zur Serie.',
      'Unsere besondere Stärke ist das Drahterodieren mit einem Verfahrweg von ca. 800 × 600 × 500 mm. Mit modernster Technik, fundiertem Know-how und über einem Jahrzehnt Erfahrung entwickeln wir maßgeschneiderte Lösungen, die exakt auf Ihre Anforderungen abgestimmt sind – von der Beratung über die Fertigung bis zum Finish.',
      'Dank unseres digitalisierten Maschinenparks reagieren wir flexibel, schnell und mit größter Präzision. Transparente Kommunikation, dokumentierte Qualität und nachvollziehbare Ergebnisse sind für uns selbstverständlich.',
    ],
    servicesKicker: 'Leistungen',
    servicesTitle: 'Von der Bearbeitung bis zur Oberfläche.',
    servicesLead: 'Weniger Schnittstellen, kürzere Durchlaufzeiten, gleichbleibende Qualität: Wir kombinieren die Verfahren, die Ihr Bauteil braucht.',
    processKicker: 'Ablauf',
    processTitle: 'Von der Zeichnung zum fertigen Teil.',
    process: [
      { t: 'Anfrage & Beratung', d: 'Sie senden Zeichnung, CAD-Daten, Skizze oder Musterteil. Wir prüfen Machbarkeit und beraten zum optimalen Verfahren.' },
      { t: 'Angebot & Planung', d: 'Sie erhalten ein transparentes Angebot. Nach Freigabe planen wir die Fertigung.' },
      { t: 'Fertigung', d: 'Drahterodieren, 5-Achs-CNC-Fräsen, Mikrobohr-Erodieren und Flachschleifen – auf unserem digitalisierten Maschinenpark.' },
      { t: 'Oberfläche & Finish', d: 'Sandstrahlen, Strömungspolieren, Pulverbeschichten und Laserbeschriftung – Ihr Bauteil kommt einbaufertig.' },
      { t: 'Messen & Liefern', d: 'Wir prüfen mit Messtechnik von Keyence und Mitutoyo, dokumentieren auf Wunsch und liefern termintreu.' },
    ],
    industriesKicker: 'Branchen',
    industriesTitle: 'Für Branchen, in denen Präzision zählt.',
    faqTitle: 'Häufige Fragen zum Erodieren',
    faq: [
      { q: 'Was ist Erodieren bzw. Funkenerosion?', a: 'Erodieren (Funkenerosion, englisch EDM – Electrical Discharge Machining) ist ein abtragendes Fertigungsverfahren. Elektrische Entladungen zwischen Werkzeug und Werkstück tragen Material berührungslos ab. So lassen sich auch gehärtete Werkstoffe und sehr feine Konturen präzise bearbeiten.' },
      { q: 'Wie hoch dürfen Werkstücke beim Drahterodieren sein?', a: 'Wir drahterodieren Werkstücke mit einer Höhe von bis zu 500 mm in der Z-Achse. Damit bearbeiten wir auch hohe Stempel, Matrizen, Formplatten und massive Bauteile, die viele Lohnfertiger ablehnen müssen.' },
      { q: 'Wo befindet sich die GRO-Erodiertechnik?', a: 'Unser Betrieb liegt in der Langenfelde 18 in 23611 Bad Schwartau, direkt bei Lübeck. Von hier aus fertigen wir für Kunden in der Region Lübeck, Hamburg und Kiel ebenso wie in ganz Deutschland und Europa.' },
      { q: 'Fertigen Sie auch für Kunden in ganz Deutschland und im Ausland?', a: 'Ja. Neben Kunden aus Norddeutschland fertigen wir für Unternehmen in ganz Deutschland und im europäischen Ausland. Anfrage und Abstimmung laufen digital, die fertigen Teile versenden wir zu Ihnen.' },
      { q: 'Wie erhalte ich ein Angebot?', a: 'Senden Sie uns Ihre Zeichnung oder Ihr CAD-Modell (z. B. STEP, DXF, PDF) per E-Mail oder über unser Kontaktformular. Wir melden uns schnellstmöglich mit einem Angebot.' },
      { q: 'Welche Stückzahlen fertigen Sie?', a: 'Vom einzelnen Prototyp über Kleinserien bis zur Serienfertigung. Durch unseren automatisierten Maschinenpark sind auch wiederkehrende Aufträge wirtschaftlich.' },
    ],
  },
  en: {
    title: 'Contract EDM & Wire EDM Services – Germany & Europe | GRO',
    description: 'Wire EDM up to 500 mm height, 5-axis CNC milling, micro-hole EDM from Ø 0.1 mm, grinding & finishing – one source, from Germany for Europe.',
    introKicker: 'About us',
    introTitle: 'Precision, innovation and service from a single source.',
    intro: [
      'Since 2011, GRO-Erodiertechnik GmbH has stood for the highest precision and reliability in metalworking. At our site in Bad Schwartau – right on the doorstep of Lübeck – we manufacture everything from single parts to series.',
      'Our particular strength is wire EDM with a travel of approx. 800 × 600 × 500 mm. With state-of-the-art technology, in-depth expertise and more than a decade of experience, we develop tailor-made solutions precisely aligned with your requirements – from consultation and manufacturing to final finishing.',
      'Thanks to our digitalised machinery, we respond flexibly, quickly and with the utmost precision. Transparent communication, documented quality and verifiable results are a matter of course for us.',
    ],
    servicesKicker: 'Services',
    servicesTitle: 'From machining to surface finish.',
    servicesLead: 'Fewer interfaces, shorter lead times, consistent quality: we combine the processes your component needs.',
    processKicker: 'Process',
    processTitle: 'From drawing to finished part.',
    process: [
      { t: 'Enquiry & advice', d: 'You send a drawing, CAD model or sample part. We check feasibility and advise on the best process.' },
      { t: 'Quote & planning', d: 'You receive a transparent quotation. Once approved, we plan production.' },
      { t: 'Manufacturing', d: 'Wire EDM, 5-axis CNC milling, micro-hole EDM and surface grinding – on our digitalised machinery.' },
      { t: 'Surface & finish', d: 'Sandblasting, abrasive flow polishing, powder coating and laser marking – your component arrives ready to install.' },
      { t: 'Measuring & delivery', d: 'We inspect with Keyence and Mitutoyo metrology, document on request and deliver on time.' },
    ],
    industriesKicker: 'Industries',
    industriesTitle: 'For industries where precision matters.',
    faqTitle: 'Frequently asked questions about EDM',
    faq: [
      { q: 'What is EDM (electrical discharge machining)?', a: 'EDM is a material-removing manufacturing process. Electrical discharges between tool and workpiece remove material without contact. This allows even hardened materials and very fine contours to be machined precisely.' },
      { q: 'How tall can workpieces be for wire EDM?', a: 'We wire-cut workpieces up to 500 mm in height on the Z axis – including tall punches, dies, mould plates and massive components that many contract shops have to turn down.' },
      { q: 'Where is GRO-Erodiertechnik located?', a: 'Our facility is at Langenfelde 18, 23611 Bad Schwartau, right next to Lübeck in northern Germany – about one hour from Hamburg. We serve customers throughout Germany and Europe.' },
      { q: 'Do you supply customers outside Germany?', a: 'Yes. We manufacture for companies throughout Germany and across Europe. Enquiries and coordination are handled digitally in English or German, and we ship the finished parts to you.' },
      { q: 'How do I get a quotation?', a: 'Send us your drawing or CAD model (e.g. STEP, DXF, PDF) by email or via our contact form. We will get back to you with a quotation as quickly as possible.' },
      { q: 'What quantities do you produce?', a: 'From single prototypes and small batches to series production. Thanks to our automated machinery, recurring orders are also cost-effective.' },
    ],
  },
}[lang];

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base lang={lang} title={c.title} description={c.description} alternates={routes.home} jsonLd={[faqLd]}>
  <WireHero lang={lang} />

  <!-- Intro -->
  <section class="section intro" aria-labelledby="intro-title">
    <div class="wrap intro__grid">
      <div class="intro__media reveal">
        <figure class="intro__fig intro__fig--a">
          <Image src={bauteil} alt={lang === 'de' ? 'Pulverbeschichtetes Präzisionsbauteil aus eigener Fertigung' : 'Powder-coated precision component from our own production'} widths={[400, 640, 900]} sizes="(max-width: 900px) 80vw, 460px" />
          <figcaption>FIG. 01</figcaption>
        </figure>
        <figure class="intro__fig intro__fig--b">
          <Image src={pharma} alt={lang === 'de' ? 'Drahterodiertes Bauteil mit Sechskant-Durchbruch' : 'Wire-EDM component with hexagonal cut-out'} widths={[300, 500]} sizes="(max-width: 900px) 45vw, 260px" />
          <figcaption>FIG. 02</figcaption>
        </figure>
      </div>
      <div class="intro__copy reveal">
        <p class="label">{c.introKicker}</p>
        <h2 id="intro-title">{c.introTitle}</h2>
        {c.intro.map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}
        <div class="intro__btns">
          <a class="btn" href={routes.contract[lang]}>{lang === 'de' ? 'Lohnerodieren für Deutschland & Europa' : 'Contract EDM for Europe'}</a>
          <a class="btn btn--ghost" href={routes.company[lang]}>{t.nav.company}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Leistungen -->
  <section class="section services" aria-labelledby="services-title">
    <div class="wrap">
      <header class="shead reveal">
        <div>
          <p class="label">{c.servicesKicker}</p>
          <h2 id="services-title">{c.servicesTitle}</h2>
        </div>
        <p class="lead">{c.servicesLead}</p>
      </header>
      <ServiceGrid lang={lang} items={services} />
    </div>
  </section>

  <!-- Prozesskette -->
  <section class="section process dark blueprint" aria-labelledby="process-title">
    <div class="wrap">
      <header class="shead reveal">
        <div>
          <p class="label">{c.processKicker}</p>
          <h2 id="process-title">{c.processTitle}</h2>
        </div>
      </header>
      <ol class="steps" role="list">
        {c.process.map((s, i) => (
          <li class="step reveal" style={`transition-delay:${i * 90}ms`}>
            <span class="step__node" aria-hidden="true"></span>
            <span class="step__no">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Maschinenpark -->
  <section class="section mp" aria-labelledby="mp-title">
    <div class="wrap mp__grid">
      <div class="reveal">
        <p class="label">{lang === 'de' ? 'Maschinenpark' : 'Machinery'}</p>
        <h2 id="mp-title">{lang === 'de' ? `${machineCount} Anlagen. Namhafte Hersteller.` : `${machineCount} systems. Renowned manufacturers.`}</h2>
        <p class="lead">{lang === 'de'
          ? 'Drahterodieren auf Sodick, Fräsen auf DMG, Mikrobohren auf AgieCharmilles, Strömungspolieren mit Extrude Hone – und Messtechnik von Keyence und Mitutoyo für dokumentierte Qualität.'
          : 'Wire EDM on Sodick, milling on DMG, micro-hole drilling on AgieCharmilles, flow polishing with Extrude Hone – and metrology from Keyence and Mitutoyo for documented quality.'}</p>
        <a class="btn" href={routes.machines[lang]}>{lang === 'de' ? 'Maschinenpark ansehen' : 'View machinery'}</a>
      </div>
      <ul class="mp__list reveal" role="list">
        {machineGroups.flatMap((g) => g.machines.map((m) => ({ g, m }))).map(({ g, m }) => (
          <li><span class="mp__area">{g.title[lang]}</span><span class="mp__name">{`${m.maker} ${m.model}`.trim()}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Branchen -->
  <section class="section industries" aria-labelledby="ind-title">
    <div class="wrap">
      <header class="shead reveal">
        <div>
          <p class="label">{c.industriesKicker}</p>
          <h2 id="ind-title">{c.industriesTitle}</h2>
        </div>
      </header>
      <ul class="ind" role="list">
        {industries.map((ind, i) => (
          <li class="ind__item reveal" style={`transition-delay:${(i % 3) * 80}ms`}>
            <Image src={ind.image} alt={ind.alt[lang]} widths={[360, 560, 800]} sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 400px" loading="lazy" />
            <span class="ind__name"><span class="ind__no">{String(i + 1).padStart(2, '0')}</span>{ind[lang]}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faqsec" aria-label={c.faqTitle}>
    <div class="wrap faqsec__in reveal">
      <Faq title={c.faqTitle} items={c.faq} />
    </div>
  </section>

  <Cta lang={lang} />
</Base>

<style>
  .shead { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1.5rem 4rem; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .shead h2 { margin: 0.9rem 0 0; max-width: 18ch; }
  .shead .lead { margin: 0; max-width: 42ch; }
  .dark h2 { color: var(--on-dark); }

  /* Intro */
  .intro__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
  @media (max-width: 900px) { .intro__grid { grid-template-columns: 1fr; } }
  .intro__copy h2 { margin-top: 1rem; }
  .intro__copy p:not(.lead):not(.label) { color: var(--muted); }
  .intro__btns { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.5rem; }
  .intro__media { position: relative; padding: 0 12% 18% 0; }
  .intro__fig { margin: 0; position: relative; }
  .intro__fig img { width: 100%; object-fit: cover; border-radius: var(--radius); }
  .intro__fig--a img { aspect-ratio: 4 / 4.4; }
  .intro__fig--b { position: absolute; right: 0; bottom: 0; width: 46%; border: 8px solid var(--paper); border-radius: calc(var(--radius) + 4px); }
  .intro__fig--b img { aspect-ratio: 1; }
  figcaption { position: absolute; top: 0.8rem; left: 0.8rem; font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.14em; padding: 0.25rem 0.5rem; background: var(--ink); color: var(--brass-glow); }

  .services { background: var(--paper-2); }

  /* Prozess */
  .steps { position: relative; display: grid; grid-template-columns: repeat(5, 1fr); gap: 2rem; list-style: none; padding: 0; margin: 0; }
  .steps::before { content: ''; position: absolute; left: 0; right: 0; top: 7px; height: 1px; background: linear-gradient(90deg, var(--brass), var(--brass-2) 60%, rgb(var(--fg-rgb) / 0.15)); box-shadow: 0 0 10px rgb(231 191 104 / 0.6); }
  .step { position: relative; padding-top: 2.4rem; }
  .step__node { position: absolute; top: 0; left: 0; width: 15px; height: 15px; border-radius: 50%; background: var(--d-bg); border: 2px solid var(--brass-2); box-shadow: 0 0 0 5px rgb(231 191 104 / 0.12); }
  .step__no { font-family: var(--font-mono); font-size: 0.75rem; color: var(--brass-2); letter-spacing: 0.1em; }
  .step h3 { color: var(--on-dark); margin: 0.5rem 0; }
  .step p { color: var(--muted-dark); font-size: 0.95rem; margin: 0; }
  @media (max-width: 1000px) {
    .steps { grid-template-columns: 1fr; gap: 0; padding-left: 2.2rem; }
    .steps::before { left: 7px; right: auto; top: 0; bottom: 0; width: 1px; height: auto; background: linear-gradient(180deg, var(--brass), rgb(var(--fg-rgb) / 0.15)); }
    .step { padding: 0 0 2.2rem; }
    .step__node { left: -2.2rem; top: 0.2rem; }
  }

  /* Branchen */
  .ind { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; list-style: none; padding: 0; margin: 0; }
  @media (max-width: 900px) { .ind { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .ind { grid-template-columns: 1fr; } }
  .ind__item { position: relative; overflow: hidden; border-radius: var(--radius); aspect-ratio: 4 / 3; background: var(--ink); }
  .ind__item img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.1) brightness(0.75); transition: transform 0.9s var(--ease), filter 0.6s; }
  .ind__item:hover img { transform: scale(1.06); filter: grayscale(0.2) brightness(0.8); }
  .ind__item::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgb(7 19 29 / 0.85)); }
  .ind__name { position: absolute; z-index: 1; left: 1.2rem; right: 1.2rem; bottom: 1.1rem; display: flex; align-items: baseline; gap: 0.7rem; color: #fff; font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); }
  .ind__no { font-family: var(--font-mono); font-size: 0.7rem; color: var(--brass-glow); }

  .faqsec__in { max-width: 900px; }
  .mp__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  @media (max-width: 900px) { .mp__grid { grid-template-columns: 1fr; } }
  .mp h2 { margin-top: 1rem; }
  .mp .btn { margin-top: 1.5rem; }
  .mp__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
  @media (max-width: 520px) { .mp__list { grid-template-columns: 1fr; } }
  .mp__list li { display: grid; gap: 0.1rem; padding: 0.75rem 0.5rem 0.75rem 0; border-bottom: 1px solid var(--line); }
  .mp__area { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brass-ink); }
  .mp__name { font-family: var(--font-display); font-weight: 600; }
</style>
