---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { routes, ui, u, type Lang } from '../i18n/ui';
import { site, mapsNavigate } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];

const c = {
  de: {
    title: 'Kontakt & Anfrage – GRO-Erodiertechnik Bad Schwartau',
    description: 'Jetzt anfragen: Zeichnung oder CAD-Datei senden und schnell ein Angebot für Erodieren, Fräsen oder CNC-Bearbeitung erhalten. Tel. +49 451 530 954 12.',
    kicker: 'Kontakt',
    h1: 'Lassen Sie uns über Ihr Bauteil sprechen.',
    lead: 'Senden Sie uns Ihre technischen Zeichnungen oder CAD-Daten – wir erstellen Ihnen zeitnah ein passgenaues Angebot mit Machbarkeitsprüfung und Liefertermin.',
    formTitle: 'Anfrage senden',
    name: 'Name', company: 'Firma', email: 'E-Mail', phone: 'Telefon', message: 'Ihre Nachricht',
    messagePh: 'Worum geht es? Beschreiben Sie Ihr Bauteil oder Ihr Anliegen – gerne auch ganz formlos.',
    detailsTitle: 'Angaben zum Bauteil',
    detailsHint: 'Alles optional – jede Angabe hilft uns beim Angebot. Was Sie noch nicht wissen, klären wir gemeinsam.',
    material: 'Material', materialPh: 'z. B. 1.2379 gehärtet',
    qty: 'Stückzahl', qtyPh: 'z. B. 1 Prototyp, 50 Stk.',
    tol: 'Toleranzen', tolPh: 'z. B. ± 0,01 mm',
    surface: 'Oberflächenbehandlung', surfacePh: 'z. B. gestrahlt, pulverbeschichtet RAL 5010',
    date: 'Wunschtermin', datePh: 'z. B. KW 12 oder „so schnell wie möglich“',
    file: 'Zeichnungen, CAD-Daten oder Fotos (optional)',
    fileHint: 'Mehrere Dateien möglich, z. B. PDF, DXF, DWG, STEP, IGES, STL, Fotos oder ZIP – zusammen bis 25 MB. Größere Daten? Schicken Sie uns einfach eine E-Mail oder einen Download-Link.',
    noDrawing: 'Keine fertige Zeichnung? Kein Problem – eine Skizze, ein Foto oder eine kurze Beschreibung genügt für den Anfang.',
    consent: `Ihre Angaben verwenden wir ausschließlich zur Bearbeitung Ihrer Anfrage. Zeichnungen und Daten behandeln wir vertraulich. Details in unserer <a href="${routes.privacy.de}">Datenschutzerklärung</a>.`,
    send: 'Anfrage absenden',
    required: 'Pflichtfeld',
    direct: 'Direkter Draht',
    contactPerson: 'Ansprechpartner',
  },
  en: {
    title: 'Contact & Enquiry – GRO-Erodiertechnik Germany',
    description: 'Request a quote now: send your drawing or CAD file and quickly receive an offer for EDM, milling or CNC machining. Phone +49 451 530 954 12.',
    kicker: 'Contact',
    h1: 'Let’s talk about your component.',
    lead: 'Send us your technical drawings or CAD data – we will promptly prepare a tailored quotation including a feasibility check and delivery date.',
    formTitle: 'Send an enquiry',
    name: 'Name', company: 'Company', email: 'Email', phone: 'Phone', message: 'Your message',
    messagePh: 'What is it about? Describe your component or request – informally is fine.',
    detailsTitle: 'Component details',
    detailsHint: 'All optional – every detail helps us quote. Anything you do not know yet, we will clarify together.',
    material: 'Material', materialPh: 'e.g. 1.2379 hardened',
    qty: 'Quantity', qtyPh: 'e.g. 1 prototype, 50 pcs',
    tol: 'Tolerances', tolPh: 'e.g. ± 0.01 mm',
    surface: 'Surface treatment', surfacePh: 'e.g. blasted, powder-coated RAL 5010',
    date: 'Target date', datePh: 'e.g. week 12 or “as soon as possible”',
    file: 'Drawings, CAD data or photos (optional)',
    fileHint: 'Multiple files possible, e.g. PDF, DXF, DWG, STEP, IGES, STL, photos or ZIP – up to 25 MB in total. Larger data? Just send us an email or a download link.',
    noDrawing: 'No finished drawing? No problem – a sketch, a photo or a short description is enough to get started.',
    consent: `We use your details solely to handle your enquiry and treat drawings and data confidentially. See our <a href="${routes.privacy.en}">privacy policy</a>.`,
    send: 'Send enquiry',
    required: 'required',
    direct: 'Direct line',
    contactPerson: 'Contact person',
  },
}[lang];

const crumbs = [{ name: t.nav.contact, href: routes.contact[lang] }];
---

<Base lang={lang} title={c.title} description={c.description} alternates={routes.contact} breadcrumbs={crumbs} pageType="ContactPage">
  <PageHero lang={lang} kicker={c.kicker} title={c.h1} lead={c.lead} crumbs={crumbs} />

  <section class="section">
    <div class="wrap ct">
      <form class="form" action={u('/kontakt.php')} method="post" enctype="multipart/form-data" data-form>
        <h2>{c.formTitle}</h2>
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="ts" value="" data-ts />
        <div class="hp" aria-hidden="true">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="form__row">
          <label class="field">
            <span>{c.name} <abbr title={c.required}>*</abbr></span>
            <input type="text" name="name" required autocomplete="name" maxlength="120" />
          </label>
          <label class="field">
            <span>{c.company}</span>
            <input type="text" name="company" autocomplete="organization" maxlength="160" />
          </label>
        </div>
        <div class="form__row">
          <label class="field">
            <span>{c.email} <abbr title={c.required}>*</abbr></span>
            <input type="email" name="email" required autocomplete="email" maxlength="160" />
          </label>
          <label class="field">
            <span>{c.phone}</span>
            <input type="tel" name="phone" autocomplete="tel" maxlength="60" />
          </label>
        </div>
        <label class="field">
          <span>{c.message}</span>
          <textarea name="message" rows="5" maxlength="8000" placeholder={c.messagePh}></textarea>
        </label>

        <fieldset class="details">
          <legend>{c.detailsTitle}</legend>
          <p class="details__hint">{c.detailsHint}</p>
          <div class="form__row">
            <label class="field"><span>{c.material}</span><input type="text" name="material" maxlength="200" placeholder={c.materialPh} /></label>
            <label class="field"><span>{c.qty}</span><input type="text" name="quantity" maxlength="200" placeholder={c.qtyPh} /></label>
          </div>
          <div class="form__row">
            <label class="field"><span>{c.tol}</span><input type="text" name="tolerances" maxlength="200" placeholder={c.tolPh} /></label>
            <label class="field"><span>{c.surface}</span><input type="text" name="surface" maxlength="200" placeholder={c.surfacePh} /></label>
          </div>
          <label class="field"><span>{c.date}</span><input type="text" name="deadline" maxlength="200" placeholder={c.datePh} /></label>
        </fieldset>

        <label class="field file">
          <span>{c.file}</span>
          <input type="file" name="attachment[]" multiple data-files />
          <small>{c.fileHint}</small>
          <small class="file__err" data-file-err hidden>{lang === 'de' ? 'Die Dateien sind zusammen größer als 25 MB. Bitte senden Sie große Daten per E-Mail oder als Download-Link.' : 'The files exceed 25 MB in total. Please send large data by email or as a download link.'}</small>
        </label>
        <p class="nodraw">{c.noDrawing}</p>
        <div class="captcha">
          <altcha-widget
            challengeurl={u('/altcha-challenge.php')}
            name="altcha"
            auto="onsubmit"
            hidefooter
            hidelogo
            strings={JSON.stringify(lang === 'de'
              ? { label: 'Ich bin kein Roboter', verifying: 'Wird geprüft …', verified: 'Bestätigt', error: 'Prüfung fehlgeschlagen – bitte erneut versuchen.', expired: 'Abgelaufen – bitte erneut bestätigen.', waitAlert: 'Prüfung läuft … bitte einen Moment.', ariaLinkLabel: 'Spamschutz', footer: '' }
              : { label: 'I am not a robot', verifying: 'Verifying …', verified: 'Verified', error: 'Verification failed – please try again.', expired: 'Expired – please verify again.', waitAlert: 'Verifying … please wait a moment.', ariaLinkLabel: 'Spam protection', footer: '' })}
          ></altcha-widget>
          <small>{lang === 'de' ? 'Spamschutz ohne Cookies und ohne Drittanbieter – die Prüfung läuft automatisch beim Absenden.' : 'Spam protection without cookies or third parties – the check runs automatically when you submit.'}</small>
        </div>
        <p class="consent" set:html={c.consent} />
        <button class="btn" type="submit">
          {c.send}
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 10h13M11 4l6 6-6 6" stroke="currentColor" stroke-width="1.8" /></svg>
        </button>
      </form>

      <aside class="ct__side dark blueprint">
        <p class="label">{c.direct}</p>
        <a class="ct__big" href={site.phoneHref}>{site.phone}</a>
        <a class="ct__mail" href={`mailto:${site.email}`}>{site.email}</a>
        <hr />
        <dl>
          <dt>{c.contactPerson}</dt>
          <dd>{site.ceo}</dd>
          <dt>{lang === 'de' ? 'Adresse' : 'Address'}</dt>
          <dd>
            <address>{site.name}<br />{site.street}<br />{site.zip} {site.city}{lang === 'en' && <><br />Germany</>}</address>
          </dd>
        </dl>
        <a class="btn btn--ghost" href={mapsNavigate} target="_blank" rel="noopener">{lang === 'de' ? 'Navigation starten' : 'Start navigation'} ↗</a>
      </aside>
    </div>
  </section>

  <section class="section mapsec" aria-labelledby="map-title">
    <div class="wrap">
      <p class="label">{lang === 'de' ? 'Anfahrt' : 'Directions'}</p>
      <h2 id="map-title">{lang === 'de' ? 'So finden Sie zu uns.' : 'How to find us.'}</h2>
      <MapEmbed lang={lang} />
    </div>
  </section>
</Base>

<script>
  import 'altcha';
  const ts = document.querySelector<HTMLInputElement>('[data-ts]');
  if (ts) ts.value = String(Math.floor(Date.now() / 1000));
  // Hinweis statt Blockade, wenn Dateien zu groß sind
  const files = document.querySelector<HTMLInputElement>('[data-files]');
  const err = document.querySelector<HTMLElement>('[data-file-err]');
  files?.addEventListener('change', () => {
    const total = [...(files.files ?? [])].reduce((sum, f) => sum + f.size, 0);
    const tooBig = total > 25 * 1024 * 1024;
    if (err) err.hidden = !tooBig;
    files.setCustomValidity(tooBig ? (err?.textContent ?? '') : '');
  });
</script>

<style>
  .mapsec { padding-top: 0; }
  .mapsec h2 { margin: 0.8rem 0 1.5rem; font-size: var(--step-3); }
  .ct { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  @media (max-width: 900px) { .ct { grid-template-columns: 1fr; } }
  .form { display: grid; gap: 1.2rem; }
  .form h2 { font-size: var(--step-2); margin-bottom: 0.4rem; }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  @media (max-width: 600px) { .form__row { grid-template-columns: 1fr; } }
  .field { display: grid; gap: 0.4rem; }
  .field > span { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  abbr { text-decoration: none; color: var(--brass-ink); }
  input[type='text'], input[type='email'], input[type='tel'], textarea {
    width: 100%; font: inherit; color: var(--text);
    padding: 0.85rem 1rem; min-height: 50px;
    background: var(--white); border: 1px solid var(--line); border-radius: var(--radius);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  input:focus, textarea:focus { outline: none; border-color: var(--brass); box-shadow: 0 0 0 3px rgb(199 154 66 / 0.2); }
  textarea { resize: vertical; }
  .file input { font: inherit; font-size: 0.95rem; padding: 0.8rem; background: var(--white); border: 1px dashed rgb(7 19 29 / 0.3); border-radius: var(--radius); }
  .file small { color: var(--muted); font-size: 0.8rem; }
  .consent { margin: 0; font-size: 0.88rem; color: var(--muted); }
  .form .btn { justify-self: start; }
  .hp { position: absolute; left: -9999px; }

  .ct__side { padding: clamp(1.8rem, 4vw, 2.8rem); border-radius: var(--radius); position: sticky; top: calc(var(--header-h) + 1.5rem); }
  .ct__big { display: block; margin-top: 1.2rem; font-family: var(--font-display); font-weight: 600; font-size: var(--step-3); line-height: 1; letter-spacing: -0.02em; color: var(--on-dark); text-decoration: none; }
  .ct__mail { display: block; margin-top: 0.8rem; color: var(--brass-2); text-decoration: none; word-break: break-all; }
  .ct__big:hover, .ct__mail:hover { color: var(--brass-2); text-decoration: underline; }
  hr { border: 0; border-top: 1px solid var(--line-dark); margin: 2rem 0; }
  dl { display: grid; gap: 0.3rem; margin: 0 0 2rem; }
  dt { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-dark); margin-top: 0.8rem; }
  dd { margin: 0; color: var(--on-dark); }
  address { font-style: normal; }
  @media (max-width: 900px) { .ct__side { position: static; } }
  .details { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.2rem 1.2rem 1.4rem; margin: 0; display: grid; gap: 1rem; }
  .details legend { padding: 0 0.4rem; font-family: var(--font-display); font-weight: 600; }
  .details__hint { margin: -0.4rem 0 0; font-size: 0.88rem; color: var(--muted); }
  .file__err { color: #b3261e !important; font-weight: 600; }
  .nodraw { margin: -0.4rem 0 0; font-size: 0.92rem; font-weight: 600; }
  .captcha { display: grid; gap: 0.4rem; }
  .captcha small { font-size: 0.8rem; color: var(--muted); }
  .captcha :global(altcha-widget) {
    --altcha-border-width: 1px;
    --altcha-border-radius: var(--radius);
    --altcha-color-base: var(--white);
    --altcha-color-border: var(--line);
    --altcha-color-text: var(--text);
    --altcha-color-border-focus: var(--brass);
    --altcha-color-error-text: #b3261e;
    --altcha-max-width: 320px;
  }
</style>
