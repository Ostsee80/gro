---
import { Image } from 'astro:assets';
import type { Service } from '../data/services';
import { servicePath, ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang; items: Service[]; headingLevel?: 'h2' | 'h3' }
const { lang, items, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<ul class="sg" role="list">
  {items.map((s, i) => (
    <li class="sg__item reveal" style={`transition-delay:${(i % 3) * 80}ms`}>
      <a href={servicePath(lang, s.slug[lang])} class="sg__card">
        <div class="sg__img">
          <Image src={s.image} alt={s.imageAlt[lang]} widths={[360, 560, 760]} sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 400px" loading="lazy" />
          <span class="sg__code">{s.code}</span>
        </div>
        <div class="sg__body">
          <span class="sg__no">{String(i + 1).padStart(2, '0')}</span>
          <H class="sg__title">{s.title[lang]}</H>
          <p>{s.teaser[lang]}</p>
          <span class="sg__more">
            {ui[lang].learnMore}
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 10h13M11 4l6 6-6 6" stroke="currentColor" stroke-width="1.8" /></svg>
          </span>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .sg { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 1px; list-style: none; margin: 0; padding: 0; background: var(--line); border: 1px solid var(--line); }
  .sg__item { background: var(--paper); }
  .sg__card { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; position: relative; }
  .sg__card:hover { color: inherit; }
  .sg__img { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--ink); }
  .sg__img img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.85) contrast(1.05); transition: transform 0.8s var(--ease), filter 0.6s; }
  .sg__card:hover img { transform: scale(1.05); filter: grayscale(0) contrast(1.05); }
  .sg__img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgb(7 19 29 / 0.55)); }
  .sg__code { position: absolute; z-index: 1; left: 1rem; bottom: 0.8rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.14em; color: var(--brass-2); }
  .sg__body { padding: 1.6rem 1.6rem 1.8rem; display: flex; flex-direction: column; flex: 1; position: relative; }
  .sg__body::before { content: ''; position: absolute; top: 0; left: 0; height: 2px; width: 0; background: var(--brass); box-shadow: 0 0 10px var(--brass-2); transition: width 0.6s var(--ease); }
  .sg__card:hover .sg__body::before { width: 100%; }
  .sg__no { font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); letter-spacing: 0.1em; }
  .sg__title { font-size: var(--step-1); margin: 0.5rem 0 0.6rem; }
  .sg__body p { color: var(--muted); font-size: 0.97rem; margin-bottom: 1.2rem; }
  .sg__more { margin-top: auto; display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; color: var(--brass-ink); }
  .sg__more svg { width: 1em; transition: transform 0.3s var(--ease); }
  .sg__card:hover .sg__more svg { transform: translateX(4px); }
</style>
