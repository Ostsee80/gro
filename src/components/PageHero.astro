---
import type { Crumb } from '../layouts/Base.astro';
import { routes, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  kicker: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  code?: string;
}
const { lang, kicker, title, lead, crumbs = [], code } = Astro.props;
const t = ui[lang];
---

<section class="ph dark blueprint">
  <div class="wrap ph__in">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href={routes.home[lang]}>{t.breadcrumbHome}</a></li>
          {crumbs.map((c, i) => (
            <li>
              {i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <p class="label">{kicker}</p>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    {code && <span class="ph__code" aria-hidden="true">{code}</span>}
    <slot />
  </div>
  <div class="ph__line" aria-hidden="true"><span></span></div>
</section>

<style>
  .ph {
    position: relative;
    overflow: hidden;
    margin-top: calc(-1 * var(--header-h));
    padding: calc(var(--header-h) + clamp(2.5rem, 5vw, 5rem)) 0 clamp(3.5rem, 6vw, 6rem);
  }
  .ph__in { position: relative; }
  h1 { margin-top: 1rem; max-width: 18ch; color: var(--on-dark); }
  .ph__code {
    position: absolute; right: 0; bottom: -0.15em;
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(4rem, 14vw, 12rem); line-height: 0.8; letter-spacing: -0.05em;
    color: transparent; -webkit-text-stroke: 1px rgb(231 191 104 / 0.28);
    pointer-events: none;
  }
  @media (max-width: 720px) { .ph__code { display: none; } }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 0 0 1.8rem; padding: 0; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.06em; color: var(--muted-dark); }
  .crumbs li + li::before { content: '/'; margin-right: 0.4rem; opacity: 0.5; }
  .crumbs a { color: var(--muted-dark); text-decoration: none; }
  .crumbs a:hover { color: var(--brass-2); }
  .crumbs [aria-current] { color: var(--on-dark); }
  .ph__line { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: rgb(var(--fg-rgb) / 0.06); }
  .ph__line span {
    position: absolute; inset: 0 auto 0 0; width: 100%;
    background: linear-gradient(90deg, transparent, var(--brass-2) 85%, var(--on-dark));
    transform-origin: left; animation: cut 1.6s var(--ease) both 0.2s;
    box-shadow: 0 0 12px var(--brass-2);
  }
  @keyframes cut { from { transform: scaleX(0); } to { transform: scaleX(1); } }
</style>
