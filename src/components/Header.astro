---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo-original.png';
import { routes, ui, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props { lang: Lang; alternates: { de: string; en: string } }
const { lang, alternates } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'de' ? 'en' : 'de';
const current = Astro.url.pathname;

const nav = [
  { href: routes.services[lang], label: t.nav.services },
  { href: routes.contract[lang], label: t.nav.contract },
  { href: routes.company[lang], label: t.nav.company },
  { href: routes.contact[lang], label: t.nav.contact },
];
const isActive = (href: string) => current.startsWith(href);
---

<header class="hdr" data-header>
  <div class="hdr__in wrap">
    <a class="brand" href={routes.home[lang]} aria-label={`${site.name} – ${t.nav.home}`}>
      <Image src={logo} alt="GRO-Erodiertechnik Logo" width={44} height={44} densities={[1, 2, 3]} loading="eager" class="brand__mark" />
      <span class="brand__txt">
        <span class="brand__name">GRO</span>
        <span class="brand__sub">Erodiertechnik</span>
      </span>
    </a>

    <nav class="nav" aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-list" data-nav-toggle>
        <span class="nav__bars" aria-hidden="true"><span></span><span></span></span>
        <span class="visually-hidden">{t.menu}</span>
      </button>
      <ul class="nav__list" id="nav-list" data-nav-list>
        {nav.map((n, i) => (
          <li>
            <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>
              <span class="nav__no" aria-hidden="true">0{i + 1}</span>{n.label}
            </a>
          </li>
        ))}
        <li class="nav__lang">
          <a href={alternates[other]} hreflang={other} lang={other} aria-label={t.langSwitchLabel}>
            <span aria-hidden="true">{other.toUpperCase()}</span>
            <span class="nav__lang-long">{t.langSwitch}</span>
          </a>
        </li>
        <li class="nav__phone">
          <a href={site.phoneHref}>{site.phone}</a>
        </li>
      </ul>
    </nav>

    <a class="btn hdr__cta" href={routes.contact[lang]}>{t.cta}</a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    header.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header.classList.contains('is-open')) toggle.click();
  });
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    color: #fff;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  /* Unschärfe auf eigener Ebene: backdrop-filter direkt am Header würde das
     fixierte Mobilmenü auf die Header-Höhe begrenzen. */
  .hdr::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(7 19 29 / 0.82);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    transition: background 0.3s;
  }
  .hdr.is-scrolled { border-bottom-color: rgb(255 255 255 / 0.08); }
  .hdr.is-scrolled::before, .hdr.is-open::before { background: rgb(7 19 29 / 0.97); }
  .hdr__in { height: 100%; display: flex; align-items: center; gap: 2rem; }

  .brand { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: #fff; flex-shrink: 0; }
  .brand:hover { color: #fff; }
  .brand__mark { width: 44px; height: 44px; border-radius: 50%; }
  .brand__txt { display: flex; flex-direction: column; line-height: 1; }
  .brand__name { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; letter-spacing: 0.02em; }
  .brand__sub { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--brass-2); margin-top: 0.3rem; }

  .nav { margin-left: auto; }
  .nav__list { display: flex; align-items: center; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .nav__list a {
    display: inline-flex; align-items: baseline; gap: 0.45rem;
    padding: 0.6rem 0.9rem;
    font-family: var(--font-display); font-weight: 500; font-size: 0.98rem;
    color: rgb(255 255 255 / 0.82); text-decoration: none;
    border-radius: var(--radius);
    transition: color 0.2s, background 0.2s;
  }
  .nav__list a:hover, .nav__list a[aria-current='page'] { color: #fff; background: rgb(255 255 255 / 0.06); }
  .nav__list a[aria-current='page'] .nav__no { color: var(--brass-2); }
  .nav__no { font-family: var(--font-mono); font-size: 0.65rem; color: rgb(255 255 255 / 0.4); }
  .nav__lang a { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.1em; }
  .nav__lang-long, .nav__phone { display: none; }
  .nav__toggle { display: none; }

  @media (max-width: 1080px) {
    .hdr__cta { display: none; }
    .nav__toggle {
      display: grid; place-items: center;
      width: 48px; height: 48px;
      background: none; border: 1px solid rgb(255 255 255 / 0.2); border-radius: var(--radius);
      color: #fff; cursor: pointer;
    }
    .nav__bars { display: grid; gap: 6px; width: 20px; }
    .nav__bars span { height: 2px; background: currentColor; transition: transform 0.3s var(--ease); }
    .is-open .nav__bars span:first-child { transform: translateY(4px) rotate(45deg); }
    .is-open .nav__bars span:last-child { transform: translateY(-4px) rotate(-45deg); }

    .nav__list {
      position: fixed;
      inset: calc(var(--header-h) - 1px) 0 0 0;
      flex-direction: column; align-items: stretch; gap: 0;
      padding: 1.5rem var(--gutter) 2rem;
      background-color: var(--ink);
      background-image: linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
      background-size: 32px 32px;
      opacity: 0; visibility: hidden; transform: translateY(-8px);
      overflow-y: auto;
      transition: opacity 0.3s, transform 0.3s var(--ease), visibility 0.3s;
    }
    .is-open .nav__list { opacity: 1; visibility: visible; transform: none; }
    .nav__list a { display: flex; width: 100%; font-size: 1.8rem; padding: 0.9rem 0; color: #fff; border-bottom: 1px solid rgb(255 255 255 / 0.22); border-radius: 0; }
    .nav__list a[aria-current='page'] { color: var(--brass-2); background: none; }
    .nav__list a:hover { background: none; }
    .nav__no { font-size: 0.8rem; color: var(--brass-2); }
    .nav__lang a { font-size: 1rem; color: #fff; }
    .nav__lang-long { display: inline; }
    .nav__lang [aria-hidden] { display: none; }
    .nav__phone { display: block; margin-top: auto; }
    .nav__phone a { font-family: var(--font-mono); font-size: 1.1rem; color: var(--brass-2); border: 0; }
  }
</style>
