---
import { routes, ui, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].ctaBlock;
---

<section class="cta dark blueprint" aria-labelledby="cta-title">
  <div class="wrap cta__in reveal">
    <div>
      <p class="label">{t.kicker}</p>
      <h2 id="cta-title">{t.title}</h2>
      <p class="lead">{t.text}</p>
    </div>
    <div class="cta__actions">
      <a class="btn" href={routes.contact[lang]}>
        {ui[lang].ctaLong}
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 10h13M11 4l6 6-6 6" stroke="currentColor" stroke-width="1.8" /></svg>
      </a>
      <a class="cta__tel" href={site.phoneHref}>
        <span>{ui[lang].call}</span>
        {site.phone}
      </a>
      <a class="cta__tel" href={`mailto:${site.email}`}>
        <span>E-Mail</span>
        {site.email}
      </a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(4rem, 8vw, 7rem); border-top: 1px solid var(--line-dark); }
  .cta__in { display: grid; grid-template-columns: 1.3fr 1fr; gap: 3rem; align-items: end; }
  @media (max-width: 860px) { .cta__in { grid-template-columns: 1fr; } }
  h2 { font-size: var(--step-4); color: #fff; margin-top: 1rem; }
  .cta__actions { display: grid; gap: 1rem; justify-items: start; }
  .cta__tel { display: grid; text-decoration: none; color: #fff; font-family: var(--font-display); font-size: var(--step-1); }
  .cta__tel span { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-dark); }
  .cta__tel:hover { color: var(--brass-2); }
</style>
