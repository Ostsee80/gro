---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, mapsPlace } from '../data/site';
import { services } from '../data/services';
import { ui, type Lang } from '../i18n/ui';

export interface Crumb { name: string; href: string }

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Pfade der Sprachversionen dieser Seite (für hreflang + Sprachumschalter) */
  alternates: { de: string; en: string };
  image?: string;
  breadcrumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
}

const {
  lang,
  title,
  description,
  alternates,
  image = '/og-image.jpg',
  breadcrumbs = [],
  jsonLd = [],
  noindex = false,
  pageType = 'WebPage',
} = Astro.props;
const staging = import.meta.env.PUBLIC_STAGING === '1';

const t = ui[lang];
const path = alternates[lang];
const canonical = new URL(path, site.url).href;
const ogImage = new URL(image, site.url).href;
const locale = lang === 'de' ? 'de_DE' : 'en_US';
const orgId = `${site.url}/#organization`;

const organization = {
  '@type': ['LocalBusiness', 'Organization'],
  '@id': orgId,
  name: site.name,
  legalName: site.name,
  alternateName: site.shortName,
  url: `${site.url}/`,
  logo: { '@type': 'ImageObject', url: `${site.url}/logo.png`, width: 196, height: 196 },
  image: ogImage,
  description:
    lang === 'de'
      ? 'Lohnfertigung für Drahterodieren, Senkerodieren, HSC-Fräsen, CNC-Bearbeitung sowie Formen- und Werkzeugbau in Bad Schwartau bei Lübeck.'
      : 'Contract manufacturing for wire EDM, sinker EDM, HSC milling, CNC machining and mould and tool making in Bad Schwartau near Lübeck, Germany.',
  foundingDate: site.founded,
  founder: { '@type': 'Person', name: site.ceo },
  employee: { '@type': 'Person', name: site.ceo, jobTitle: lang === 'de' ? 'Geschäftsführer' : 'Managing Director' },
  telephone: site.phone.replace(/\s/g, ''),
  email: site.email,
  vatID: site.vatId.replace(/\s/g, ''),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    postalCode: site.zip,
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: mapsPlace,
  areaServed: site.areaServed.map((name) => ({ '@type': 'Place', name })),
  knowsAbout: ['Drahterodieren', 'Senkerodieren', 'Funkenerosion', 'Wire EDM', 'Sinker EDM', 'HSC-Fräsen', 'CNC-Bearbeitung', 'Formenbau', 'Werkzeugbau', 'Pulverbeschichtung', 'Lasergravur'],
  makesOffer: services.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: s.title[lang], url: `${site.url}${lang === 'de' ? '/leistungen/' : '/en/services/'}${s.slug[lang]}/` },
  })),
  priceRange: '€€',
};

const graph: Record<string, unknown>[] = [
  organization,
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: `${site.url}/`,
    name: site.name,
    inLanguage: ['de-DE', 'en-US'],
    publisher: { '@id': orgId },
  },
  {
    '@type': pageType,
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: lang === 'de' ? 'de-DE' : 'en-US',
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': orgId },
    primaryImageOfPage: ogImage,
  },
];

if (breadcrumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: t.breadcrumbHome, href: lang === 'de' ? '/' : '/en/' }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.href, site.url).href,
    })),
  });
}
graph.push(...jsonLd);

const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex || staging ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

    <link rel="alternate" hreflang="de" href={new URL(alternates.de, site.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, site.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.de, site.url).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={locale} />
    <meta property="og:locale:alternate" content={lang === 'de' ? 'en_US' : 'de_DE'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="geo.region" content="DE-SH" />
    <meta name="geo.placename" content={site.city} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />

    <meta name="theme-color" content="#07131d" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={ld} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header lang={lang} alternates={alternates} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Elemente beim Scrollen einblenden
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
