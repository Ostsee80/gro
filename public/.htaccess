# ==========================================================================
# GRO-Erodiertechnik – Apache-Konfiguration (netcup Webhosting)
# ==========================================================================

Options -Indexes

# Interne Konfigurationsdateien nicht ausliefern
<FilesMatch "^(\.(user\.ini|htaccess|altcha-key\.php)|_altcha\.php)$">
  Require all denied
</FilesMatch>
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS erzwingen + www auf Hauptdomain ----------------------------
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # --- Alte URLs (Baukasten-Seite) dauerhaft umleiten -------------------
  # Die alte Seite war englisch → auf die englischen Pendants leiten,
  # damit vorhandene Rankings erhalten bleiben.
  RewriteRule ^services/?$ /en/services/ [L,R=301]
  RewriteRule ^company/?$ /en/company/ [L,R=301]
  RewriteRule ^contact/?$ /en/contact/ [L,R=301]
  RewriteRule ^legal-notice/?$ /en/legal-notice/ [L,R=301]
  RewriteRule ^privacy/?$ /en/privacy/ [L,R=301]

  # --- Alte Sitemap-Adresse (Baukasten) auf die neue Sitemap leiten -----
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [L,R=301]

  # --- Frühere Entwurfs-Adressen auf die neuen Unterordner leiten ---------
  RewriteRule ^entwurf-hell/(.*)$ /1/$1 [L,R=301]
  RewriteRule ^barth/(.*)$ /2/$1 [L,R=301]

  # --- Umbenannte / zusammengelegte Leistungsseiten (gilt auch für Entwürfe) ---
  RewriteRule ^((?:1/|2/)?)leistungen/hsc-fraesen/?$ /$1leistungen/cnc-fraesen/ [L,R=301]
  RewriteRule ^((?:1/|2/)?)leistungen/cnc-bearbeitung/?$ /$1leistungen/cnc-fraesen/ [L,R=301]
  RewriteRule ^((?:1/|2/)?)leistungen/drehen-schleifen-bohren/?$ /$1leistungen/flachschleifen/ [L,R=301]
  RewriteRule ^((?:1/|2/)?)leistungen/formenbau-werkzeugbau/?$ /$1leistungen/ [L,R=301]
  RewriteRule ^((?:1/|2/)?)leistungen/lasergravur/?$ /$1leistungen/laserbeschriftung-gravieren/ [L,R=301]
  RewriteRule ^((?:1/|2/)?)leistungen/sonderloesungen/?$ /$1leistungen/ [L,R=301]
  RewriteRule ^((?:1/|2/)?)leistungen/stroemungsschleifen/?$ /$1leistungen/stroemungspolieren/ [L,R=301]
  RewriteRule ^((?:1/|2/)?)en/services/hsc-milling/?$ /$1en/services/cnc-milling/ [L,R=301]
  RewriteRule ^((?:1/|2/)?)en/services/cnc-machining/?$ /$1en/services/cnc-milling/ [L,R=301]
  RewriteRule ^((?:1/|2/)?)en/services/turning-grinding-drilling/?$ /$1en/services/surface-grinding/ [L,R=301]
  RewriteRule ^((?:1/|2/)?)en/services/mould-tool-making/?$ /$1en/services/ [L,R=301]
  RewriteRule ^((?:1/|2/)?)en/services/laser-engraving/?$ /$1en/services/laser-marking-engraving/ [L,R=301]
  RewriteRule ^((?:1/|2/)?)en/services/custom-solutions/?$ /$1en/services/ [L,R=301]
  RewriteRule ^((?:1/|2/)?)en/services/abrasive-flow-machining/?$ /$1en/services/abrasive-flow-polishing/ [L,R=301]

  # --- Fehlenden Schrägstrich bei Verzeichnissen ergänzen ---------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# --- Sicherheits-Header ---------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# --- Komprimierung --------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# --- Browser-Caching ------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Von Astro gehashte Dateien sind unveränderlich
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
